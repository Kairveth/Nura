# Copia a .env y rellena. Nunca subas .env al repo.
NODE_ENV=development
PORT=3001
# Lista blanca de orígenes CORS (varios separados por comas). Obligatoria en producción.
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Conexiones máximas del pool (opcional, por defecto 10). Ajusta al límite de tu Postgres.
DB_POOL_MAX=10

# Fotos de perfil (Supabase Storage, bucket "profile-photos", público solo para lectura).
# SUPABASE_SERVICE_KEY es la "service_role key" del panel de Supabase: nunca la uses en el
# frontend ni la confundas con la anon key, omite RLS por completo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=

# Email transaccional (recuperar contraseña). Dominio de pruebas de Resend: solo entrega al email
# de tu propia cuenta. Con dominio verificado, cambia EMAIL_FROM a algo como no-reply@tudominio.com.
RESEND_API_KEY=
EMAIL_FROM=Nura <onboarding@resend.dev>
